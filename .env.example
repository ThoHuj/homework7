# Copy to .env and fill in your values:
#   cp .env.example .env

# Required for the default OpenAI model
OPENAI_API_KEY=sk-your-key-here

# LiteLLM model string (optional)
MODEL=gpt-4o-mini

# Override the cheerleader system prompt (optional)
# SYSTEM_PROMPT=You are an overly enthusiastic cheerleader assistant!

# HTTP listen port (optional)
PORT=8000

# Max messages kept per session (optional)
HISTORY_LIMIT=20
